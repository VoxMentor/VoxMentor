<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.14" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.12" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.0.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxMentor.Application\VoxMentor.Application.csproj" />
    <ProjectReference Include="..\VoxMentor.Domain\VoxMentor.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Opt in to the shared worker copy target (see Directory.Build.targets).
         Infrastructure is the common dependency of Api and Tests, so it owns the
         worker build (BuildPdfExtractorWorker) — exactly one builder per build
         session; Api/Tests only resolve the output path read-only. -->
    <CopyPdfExtractorWorker>true</CopyPdfExtractorWorker>
    <BuildPdfExtractorWorker>true</BuildPdfExtractorWorker>
  </PropertyGroup>

  <ItemGroup>
    <!-- Single-source tutor prompt (#77): same file scripts/eval-tutor.py renders. -->
    <EmbeddedResource Include="..\..\prompts\tutor-prompt.txt" LogicalName="VoxMentor.Infrastructure.tutor-prompt.txt" />
  </ItemGroup>

</Project>
