# Copy to .env (gitignored) before `docker compose up`.
# Compose reads .env automatically from the project directory.
POSTGRES_PASSWORD=changeme-local-only
JUDGE0_SECRET_KEY=changeme-local-only

# Demo seed data (SETUP.md Step 4c).
# Set to "true" to auto-seed demo accounts + content on API startup.
# Default: false — production boots clean.
# One-liner alternative: `dotnet run --project src/VoxMentor.Api -- --seed-demo`
# Seed__Demo=false
# Seed__DemoPassword=<required when Seed:Demo=true — no default shipped>