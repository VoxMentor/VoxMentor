# Copy to .env (gitignored) before `docker compose up`.
# Compose reads .env automatically from the project directory.

# Database is now Supabase - set the connection string for the API instead:
# ConnectionStrings__DefaultConnection=Host=<supabase-host>;Port=5432;Database=postgres;Username=postgres;Password=<supabase-password>;SslMode=Require;
# For IPv4-only networks without the Supabase IPv4 add-on, use the session pooler:
# ConnectionStrings__DefaultConnection=Host=<project-ref>.pooler.supabase.com;Port=6543;Database=postgres;Username=postgres.<project-ref>;Password=<supabase-password>;SslMode=Require;

# Optional: Hangfire (falls back to DefaultConnection if not set)
# ConnectionStrings__Hangfire=Host=<supabase-host>;Port=5432;Database=postgres;Username=postgres;Password=<supabase-password>;SslMode=Require;

# --- When running VoxMentor.Api via `dotnet run` (host, not Docker) ---
# The .env file is NOT auto-loaded by the .NET host. Choose one:
# 1) Export in your shell before `dotnet run`:
#    export ConnectionStrings__DefaultConnection="Host=...;Database=postgres;Username=postgres;Password=...;SslMode=Require"
# 2) Use .NET user secrets (recommended for local dev):
#    dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=...;Database=postgres;Username=postgres;Password=...;SslMode=Require" --project src/VoxMentor.Api
# 3) Add to src/VoxMentor.Api/appsettings.Development.json (gitignored):
#    "ConnectionStrings": { "DefaultConnection": "Host=...;Database=postgres;Username=postgres;Password=...;SslMode=Require" }

# Demo seed data (SETUP.md Step 4c).
# Set to "true" to auto-seed demo accounts + content on API startup.
# Default: false - production boots clean.
# One-liner alternative: `dotnet run --project src/VoxMentor.Api -- --seed-demo`
# Seed__Demo=false
# Seed__DemoPassword=<required when Seed:Demo=true - no default shipped>

# OpenTelemetry tracing (#154). The collector is the `otel-collector` compose
# service; every service exports OTLP to it. The API and the gateway run on
# the host in local dev, so export these in your shell for them (see
# docs/tracing.md). The compose voice service reads the VOICE_-prefixed pair
# instead, so a host `localhost` endpoint cannot leak into the container;
# its default is the collector, and an empty value disables export.
# gRPC (default for .NET services, no path needed):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# HTTP/protobuf (requires /v1/traces path; voice service uses this):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=console   # print the spans to stdout instead
# VOICE_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
