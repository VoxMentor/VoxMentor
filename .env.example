# Copy to .env (gitignored) before `docker compose up`.
# Compose reads .env automatically from the project directory.
POSTGRES_PASSWORD=changeme-local-only
JUDGE0_SECRET_KEY=changeme-local-only

# Demo seed data (SETUP.md Step 4c).
# Set to "true" to auto-seed demo accounts + content on API startup.
# Default: false — production boots clean.
# One-liner alternative: `dotnet run --project src/VoxMentor.Api -- --seed-demo`
# Seed__Demo=false
# Seed__DemoPassword=<required when Seed:Demo=true — no default shipped>

# OpenTelemetry tracing (#154). The collector is the `otel-collector` compose
# service; every service exports OTLP to it over http/protobuf on 4318.
# The API and the gateway run on the host in local dev, so export these in
# your shell for them (see docs/tracing.md). The compose voice service reads
# the VOICE_-prefixed pair instead, so a host `localhost` endpoint cannot
# leak into the container; its default is the collector, and an empty value
# disables export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_EXPORTER=console   # print the spans to stdout instead
# VOICE_OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
