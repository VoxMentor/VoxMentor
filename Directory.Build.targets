<Project>

  <!-- #151: PDF extraction worker (VoxMentor.Workers.PdfExtractor) is built as a
       standalone exe and copied next to its consumers (Api, Infrastructure, Tests)
       so PdfPigTextExtractor can launch it in an isolated process.

       Projects opt in with <CopyPdfExtractorWorker>true</CopyPdfExtractorWorker>
       (and <CopyPdfExtractorWorkerToPublish>true</...> for publish output).

       The worker is deliberately NOT a ProjectReference and NOT in the slnx:
       - As a ProjectReference, the SDK's publish pipeline builds it twice (with
         and without RID) and fails with NETSDK1152 duplicate-output errors, and
         self-contained restore omits the RID for referenced projects (NETSDK1047).
       - Outside the solution, worker builds are owned and serialized:
         Infrastructure (the common dependency of every consumer) builds it via
         Restore;Build;GetTargetPath; Api and Tests only resolve the output path
         with a read-only GetTargetPath — no build, no writes — so two worker
         builds never run concurrently, even when Api and Tests build in parallel.
       - Exception: the SDK strips RuntimeIdentifier from referenced-project
         builds, so Infrastructure can only ever build the non-RID worker. Any
         consumer that itself has a RID (self-contained build/publish) therefore
         builds the RID-specific worker in its own context.

       The output path is resolved inside the target via GetTargetPath — a
       project-level wildcard would expand before the worker builds and come up
       empty on clean builds (CodeRabbit r4464130409) — and RuntimeIdentifier is
       forwarded so RID-specific consumers copy from the worker's RID-specific
       output folder (CodeRabbit r4464130429). A missing worker output fails the
       build loudly instead of copying nothing.
       ponytail: worker stays framework-dependent; also pass SelfContained if
       deployments ever target machines without the shared .NET runtime. -->
  <PropertyGroup>
    <_PdfWorkerProject>$(MSBuildThisFileDirectory)src\VoxMentor.Workers.PdfExtractor\VoxMentor.Workers.PdfExtractor.csproj</_PdfWorkerProject>
    <!-- Build when this project owns the build (Infrastructure) or when it is
         RID-specific (Infrastructure cannot build the RID variant for it). -->
    <_PdfWorkerTargets Condition="'$(BuildPdfExtractorWorker)' == 'true' or '$(RuntimeIdentifier)' != ''">Restore;Build;GetTargetPath</_PdfWorkerTargets>
    <_PdfWorkerTargets Condition="'$(BuildPdfExtractorWorker)' != 'true' and '$(RuntimeIdentifier)' == ''">GetTargetPath</_PdfWorkerTargets>
    <_PdfWorkerPublishTargets Condition="'$(RuntimeIdentifier)' != ''">Restore;Build;GetTargetPath</_PdfWorkerPublishTargets>
    <_PdfWorkerPublishTargets Condition="'$(RuntimeIdentifier)' == ''">GetTargetPath</_PdfWorkerPublishTargets>
  </PropertyGroup>

  <Target Name="CopyPdfExtractorWorker" AfterTargets="Build" Condition="'$(CopyPdfExtractorWorker)' == 'true'">
    <MSBuild Projects="$(_PdfWorkerProject)" Targets="$(_PdfWorkerTargets)"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_PdfWorkerTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_PdfWorkerFiles Include="%(_PdfWorkerTargetPath.RootDir)%(_PdfWorkerTargetPath.Directory)*" />
    </ItemGroup>
    <Error Condition="'@(_PdfWorkerFiles)' == ''"
           Text="PDF extraction worker output not found under the worker's bin folder; build VoxMentor.Workers.PdfExtractor first." />
    <Copy SourceFiles="@(_PdfWorkerFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPdfExtractorWorkerToPublish" AfterTargets="Publish" Condition="'$(CopyPdfExtractorWorkerToPublish)' == 'true'">
    <MSBuild Projects="$(_PdfWorkerProject)" Targets="$(_PdfWorkerPublishTargets)"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)">
      <Output TaskParameter="TargetOutputs" ItemName="_PdfWorkerPublishTargetPath" />
    </MSBuild>
    <ItemGroup>
      <_PdfWorkerPublishFiles Include="%(_PdfWorkerPublishTargetPath.RootDir)%(_PdfWorkerPublishTargetPath.Directory)*" />
    </ItemGroup>
    <Error Condition="'@(_PdfWorkerPublishFiles)' == ''"
           Text="PDF extraction worker output not found under the worker's bin folder; build VoxMentor.Workers.PdfExtractor first." />
    <Copy SourceFiles="@(_PdfWorkerPublishFiles)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
